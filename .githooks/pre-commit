#!/usr/bin/env bash
set -euo pipefail

branch=$(git branch --show-current)
if [ -z "$branch" ] || [ "$branch" = "main" ]; then
  echo "pre-commit: commits to main or a detached HEAD are not allowed. Use a task branch." >&2
  exit 1
fi

if git diff --cached --name-only | grep -E '\.rs$|^Cargo\.(toml|lock)$|^rust-toolchain\.toml$|^\.cargo/' >/dev/null; then
  cargo format-check
  cargo lint
  cargo lint-docs
fi
